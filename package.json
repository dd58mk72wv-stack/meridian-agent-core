{
  "name": "@meridian/agent-core",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "The shared core every Meridian client system is built on. CMO to Manager to Agent, the voice chain, and the integration adapters. Consumed by version tag, so a fix lands once and each client bumps.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./voice": "./src/voice/index.ts",
    "./db": "./src/core/db.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/__tests__/*.test.mts'",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "googleapis": "^180.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
